<?php

/**
 * @file
 * Module file.
 */

declare(strict_types=1);

use Drupal\preview_link\Hook\PreviewLinkEntityHooks;
use Drupal\preview_link\Hook\PreviewLinkHooks;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\preview_link\Hook\PreviewLinkDeleteHooks;

/**
 * Implements hook_entity_type_alter().
 */
#[LegacyHook]
function preview_link_entity_type_alter(array &$entity_types): void {
  \Drupal::service(PreviewLinkHooks::class)->entityTypeAlter($entity_types);
}

/**
 * Implements hook_cron().
 */
#[LegacyHook]
function preview_link_cron(): void {
  \Drupal::service(PreviewLinkHooks::class)->cron();
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function preview_link_theme(array $existing, string $type, string $theme, string $path): array {
  return \Drupal::service(PreviewLinkHooks::class)->theme($existing, $type, $theme, $path);
}

/**
 * Implements hook_entity_access().
 */
#[LegacyHook]
function preview_link_entity_access(EntityInterface $entity, string $operation, AccountInterface $account): AccessResultInterface {
  return \Drupal::service(PreviewLinkEntityHooks::class)->entityAccess($entity, $operation, $account);
}

/**
 * Implements hook_entity_field_access().
 */
#[LegacyHook]
function preview_link_entity_field_access(string $operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL): AccessResultInterface {
  return \Drupal::service(PreviewLinkHooks::class)->entityFieldAccess($operation, $field_definition, $account, $items);
}

/**
 * Implements hook_entity_predelete().
 */
#[LegacyHook]
function preview_link_entity_predelete(EntityInterface $entity): void {
  \Drupal::service(PreviewLinkDeleteHooks::class)->entityPreDelete($entity);
}

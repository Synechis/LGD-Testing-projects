parameters:
  ignoreErrors:
    # These attributes got removed in core 10.4.8 but are part of 11.
    # Included them does not appear to have side effects.
    - '#Attribute class Drupal\\Core\\Hook\\Attribute\\Hook does not exist.#'
    - '#Attribute class Drupal\\Core\\Hook\\Attribute\\LegacyHook does not exist.#'
    - '#Attribute class Drupal\\Core\\Hook\\Attribute\\LegacyModuleImplementsAlter does not exist.#'
    - '#Access to constant Last on an unknown class Drupal\\Core\\Hook\\Order\\Order.#'
    - '#Attribute class PHPUnit\\Framework\\Attributes\\Group does not exist.#'

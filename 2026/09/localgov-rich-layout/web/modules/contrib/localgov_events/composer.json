{
    "name": "drupal/localgov_events",
    "description": "Events for LocalGov Drupal",
    "type": "drupal-module",
    "homepage": "https://www.drupal.org/project/localgov_events",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "dev",
    "require": {
        "drupal/date_recur": "^3.2",
        "drupal/date_recur_modular": "^3.1@RC",
        "drupal/facets": "^2.0 || ^3.0",
        "drupal/search_api": "^1.17",
        "drupal/localgov_core": "^2.12 || ^3.0",
        "drupal/localgov_geo": "^2.0",
        "rlanvin/php-rrule": "^1.0|^2.0"
    },
    "require-dev": {
        "drupal/entity_usage": "^2.0@beta",
        "drupal/paragraphs": "^1.13",
        "drupal/localgov_directories": "^3.0",
        "drupal/localgov_search": "^1.2",
        "drupal/localgov_topics": "^1.1",
        "drupal/localgov_workflows": "^1.3"
    },
    "extra": {
        "enable-patching": true,
        "composer-exit-on-patch-failure": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/date_recur_modular": {
                "Date validation #3154944": "https://www.drupal.org/files/issues/2020-06-25/alpha-modal-form-end-date-validation.patch"
            }
        }
    }
}

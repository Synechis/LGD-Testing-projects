{
    "name": "drupal/localgov_subsites",
    "description": "Provides subsite sections using page builder paragraph types for LocalGovDrupal.",
    "type": "drupal-module",
    "homepage": "https://drupal.org/project/localgov_subsites",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "dev",
    "require": {
        "drupal/entity_hierarchy": "^3.3",
        "drupal/preview_link": "^2.1@alpha",
        "drupal/tablefield": "^2.4 || ^3.0@beta",
        "drupal/viewsreference": "^2.0",
        "drupal/localgov_core": "^2.12 || ^3.0",
        "drupal/localgov_paragraphs": "^2.3"
    },
    "require-dev": {
        "drupal/localgov_base": "^2.2",
        "drupal/localgov_services": "^2.1",
        "drupal/localgov_search": "^1.2",
        "drupal/preview_link": "^2.2@alpha"
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/preview_link": {
                "Automatically populating multiple preview link entities #3439968": "https://www.drupal.org/files/issues/2026-09-04/3439968-9.patch",
                "Add a 'copy to clipboard' feature for preview_link": "https://www.drupal.org/files/issues/2024-08-15/3449121-10.patch",
                "References to other entities being previewed don't display #3481523": "https://www.drupal.org/files/issues/2026-09-07/3481523-10.patch",
                "Set Preview Link expiry in days #3510967": "https://www.drupal.org/files/issues/2025-03-11/3510967-4.patch"
            }
        }
    }
}

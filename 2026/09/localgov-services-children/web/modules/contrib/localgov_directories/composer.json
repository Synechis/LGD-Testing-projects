{
    "name": "drupal/localgov_directories",
    "description": "LocalGovDrupal distribution: Directories feature.",
    "type": "drupal-module",
    "homepage": "https://www.drupal.org/project/localgov_directories",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "dev",
    "require": {
        "drupal/core": "^10.2 || ^11.0",
        "drupal/facets": "^2.0.7 || ^3.0",
        "drupal/leaflet": "^10.3",
        "drupal/pathauto": "^1.6",
        "drupal/search_api": "^1.29",
        "drupal/search_api_autocomplete": "^1.3",
        "drupal/search_api_location": "1.0.0-alpha4",
        "drupal/localgov_core": "^2.12 || ^3.0",
        "drupal/localgov_geo": "^2.0"
    },
    "require-dev": {
        "drupal/better_exposed_filters": "^7.1",
        "drupal/facets_form": "^1.0",
        "drupal/localgov_search": "^1.2",
        "drupal/localgov_services": "^2.1",
        "drupal/localgov_openreferral": "^2.0",
        "drupal/localgov_paragraphs": "^2.3",
        "drupal/preview_link": "^2.0@alpha"
    },
    "suggest": {
        "drupal/facets_form": "Displays facets as checkboxes within a form.",
        "drupal/localgov_openreferral": "Enables Open Referral output of Directories",
        "drupal/localgov_paragraphs": "For Directory Promo Page content type in Directories"
    },
    "extra": {
        "patches": {
            "drupal/facets": {
                "Don't render facet block if backend isn't available: https://www.drupal.org/project/facets/issues/3311856": "https://git.drupalcode.org/issue/facets-3311856/-/commit/765d5ef4228906c7f201e116763f3018a7867c96.patch"
            },
            "drupal/preview_link": {
                "Automatically populating multiple preview link entities #3439968": "https://www.drupal.org/files/issues/2026-09-04/3439968-9.patch"
            }
        }
    }
}
